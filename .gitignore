__pycache__/
*.egg-info/
.worktrees/
.workspace/
runs/
.superpowers/
.env
.vscode/
opencode.json
/build/
# specs, plans and reviews are versioned; scratch is not. Note the
# trailing `*`: git does not descend into an excluded directory, so
# `docs/superpowers/` plus a negation would not work — the parent must
# stay traversable.
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/
!docs/superpowers/reviews/
# generated benchmark/analysis artifacts (E-83 review note)
artifacts/
# npm workspace root
node_modules/
interfaces/ui/dist-ds/
interfaces/ui/dist-types/
