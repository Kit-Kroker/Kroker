      "type": "seed.spec",
      "kind": "stage",
      "role": null,
      "canonical_stage": "architecture",
      "default_id": "seed_spec",
      "ports": [
        {
          "name": "trigger",
          "direction": "in",
          "payload": null,
          "required": false,
          "multiplicity": "one"
        },
        {
          "name": "spec",
          "direction": "out",
          "payload": "ArchitectureSpec",
          "required": true,
          "multiplicity": "one"
        },
        {
          "name": "fail",
          "direction": "out",
          "payload": "NodeFailure",
          "required": true,
          "multiplicity": "one"
        }
      ],
      "connectable": {
        "spec": [
          {
            "type": "gate.architecture",
            "port": "artifact"
          },
          {
            "type": "merge",
            "port": "spec"
          },
          {
            "type": "plan",
            "port": "spec"
          }
        ],
        "fail": []
      }
    }
  ],
  "canonical_stages": [
    "intake",
    "constitution",
    "context",
    "requirements",
    "research",
    "clarify",
    "architecture",
    "planning",
    "code",
    "review",
    "adversary",
    "handoff",
    "deep_review",
    "analyze",
    "qa",
    "quality_gate",
    "deploy",
    "retro"
  ],
  "schemas": {
    "GraphNode": {
      "$defs": {
        "GateConfig": {
          "description": "Per-gate policy + the confidence bar a SOFT gate must clear to\nauto-approve (FR-301), plus the E-9 timer schedule. threshold is read\nonly when policy == SOFT; the *_after_hours fields fall back to a\nfraction of PipelineConfig.gate_timeout_hours when None (see\nsdlc.notify.schedule.build_schedule).",
          "properties": {
            "policy": {
              "$ref": "#/$defs/GatePolicy",
              "default": "hard"
            },
            "threshold": {
              "default": 0.8,
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Threshold",
              "type": "number"
            },
            "on_timeout": {
              "$ref": "#/$defs/TimeoutAction",
              "default": "reject"
            },
            "remind_after_hours": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Remind After Hours"
            },
            "escalate_after_hours": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Escalate After Hours"
            }
          },
          "title": "GateConfig",
          "type": "object"
        },
        "GatePolicy": {
          "enum": [
            "hard",
            "soft",
            "off"
          ],
          "title": "GatePolicy",
          "type": "string"
        },
        "HarnessKind": {
          "enum": [
            "claude_code",
            "opencode",
            "cursor",
            "crew"
          ],
          "title": "HarnessKind",
          "type": "string"
        },
        "NodePosition": {
          "additionalProperties": false,
          "description": "Canvas coordinates. Cosmetic: never part of content_sha().",
          "properties": {
            "x": {
              "title": "X",
              "type": "number"
            },
            "y": {
              "title": "Y",
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "title": "NodePosition",
          "type": "object"
        },
        "RoleConfig": {
          "description": "Which harness/model a 'doing' role uses. Enables cross-harness review.",
          "properties": {
            "kind": {
              "default": "harness",
              "enum": [
                "proposer",
                "harness",
                "research"
              ],
              "title": "Kind",
              "type": "string"
            },
            "harness": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HarnessKind"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Model"
            },
            "layout": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Layout"
            },
            "lead_harness": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HarnessKind"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "provider": {
              "anyOf": [
                {
                  "enum": [
                    "tavily",
                    "exa",
                    "fake"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Provider"
            },
            "tool_files": {
              "items": {
                "type": "string"
              },
              "title": "Tool Files",
              "type": "array"
            },
            "instructions": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Instructions"
            },
            "context_budget_tokens": {
              "default": 30000,
              "title": "Context Budget Tokens",
              "type": "integer"
            },
            "extra_args": {
              "items": {
                "type": "string"
              },
              "title": "Extra Args",
              "type": "array"
            },
            "activity_timeout_hours": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Activity Timeout Hours"
            },
            "activity_heartbeat_minutes": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Activity Heartbeat Minutes"
            }
          },
          "title": "RoleConfig",
          "type": "object"
        },
        "TimeoutAction": {
          "description": "What an expired gate does (FR-303). REJECT is today's behaviour and\nthe default everywhere except `merge` -- see PipelineConfig.gates.",
          "enum": [
            "reject",
            "approve",
            "hold"
          ],
          "title": "TimeoutAction",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "One node. `role`/`gate` carry the core models verbatim (spec D6/D7):\na PipelineConfig.roles / PipelineConfig.gates ENTRY's semantics, resolved\nby E-74 -- nothing here interprets them.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "title": "Type",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/GateConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodePosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "description": "A directed connection. Identity is the endpoint 4-tuple (no id field);\nduplicates are validate.py's to reject.",
      "properties": {
        "source": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Port",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Port",
          "type": "string"
        },
        "max_traversals": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Traversals"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "source",
        "source_port",
        "target",
        "target_port"
      ],
      "title": "GraphEdge",
      "type": "object"
    }
  },
  "capabilities": {
    "validate": false,
    "save": true,
    "load": true,
    "run_graph": false
  },
  "max_graph_bytes": 262144
}
