# Shell-neutral environment for sdlc-temporal.
# Copy to `.env` and fill in. Loaded automatically by python-dotenv
# (worker.py, cli.py) — no need to source manually.

# --- z.ai (Anthropic-compatible endpoint) ---
# Powers the Pydantic AI "thinking" agents (clarify, architect, planner, QA).
ANTHROPIC_API_KEY=your-zai-api-key
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Temporal ---
TEMPORAL_HOST=localhost:7233

# --- Tavily (research provider) ---
# Required when a kind=research role declares `provider: tavily` in its
# agent.yaml. validate_registry fails closed at boot without it.
TAVILY_API_KEY=your-tavily-api-key

# --- Tunables (optional) ---
# SDLC_WORKTREES_ROOT=/tmp/sdlc/worktrees
# SDLC_MODEL_MAX_TOKENS=64000
# SDLC_LONG_ACTIVITY_HEARTBEAT_MINUTES=60
# SDLC_LONG_ACTIVITY_TIMEOUT_HOURS=4
# Path to the agents/ registry directory. Set explicitly in the image; locally
# it is discovered by walking up for pyproject.toml + agents/registry.yaml.
# SDLC_AGENTS_DIR=/app/agents
