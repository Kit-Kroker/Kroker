# Shell-neutral environment for sdlc-temporal.
# Copy to `.env` and fill in. Loaded automatically by python-dotenv
# (worker.py, cli.py) — no need to source manually.

# --- z.ai (Anthropic-compatible endpoint) ---
# Powers the Pydantic AI "thinking" agents (clarify, architect, planner, QA).
ANTHROPIC_API_KEY=your-zai-api-key
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Temporal ---
TEMPORAL_HOST=localhost:7233

# --- Tavily (research provider) ---
# Required when a kind=research role declares `provider: tavily` in its
# agent.yaml. validate_registry fails closed at boot without it.
TAVILY_API_KEY=your-tavily-api-key

# --- Hindsight memory backend (docker-compose "hindsight" service) ---
# Required for the memory bank's LLM-backed retain/recall/reflect. Any
# HINDSIGHT_API_LLM_PROVIDER-compatible key (openai, anthropic, gemini, ...).
HINDSIGHT_API_LLM_API_KEY=your-llm-api-key
HINDSIGHT_API_LLM_PROVIDER=openai
# Flip these to actually use Hindsight instead of the in-process fake backend.
SDLC_MEMORY_ENABLED=true
SDLC_MEMORY_BACKEND=hindsight
SDLC_MEMORY_BASE_URL=http://hindsight:8888
# Tenant path segment; `default` for a single-tenant self-hosted container.
SDLC_MEMORY_TENANT=default
# Only needed if the Hindsight deployment enforces bearer auth. Read inside
# the activity and never placed on an activity input — those are serialized
# into Temporal workflow history.
# SDLC_MEMORY_API_KEY=

# --- GitHub (pull-request delivery) ---
# Read by `gh` (and, through the image's credential helper, by `git push`) in
# activities.open_pull_request — the last step of a feature run. Without it a
# run reaches the PR step with every gate green and then fails to push.
# Needs `repo` scope on the repository the run targets. Benchmark runs skip
# the PR step entirely (scratch checkouts have no remote), so this is only
# required for real runs against a GitHub repository.
GH_TOKEN=your-github-token

# --- Tunables (optional) ---
# SDLC_WORKTREES_ROOT=/tmp/sdlc/worktrees
# SDLC_MODEL_MAX_TOKENS=64000
# SDLC_LONG_ACTIVITY_HEARTBEAT_MINUTES=60
# SDLC_LONG_ACTIVITY_TIMEOUT_HOURS=4
# Path to the agents/ registry directory. Set explicitly in the image; locally
# it is discovered by walking up for pyproject.toml + agents/registry.yaml.
# SDLC_AGENTS_DIR=/app/agents
