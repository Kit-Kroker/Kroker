# Shell-neutral environment for sdlc-temporal.
# Copy to `.env` and fill in. Loaded automatically by python-dotenv
# (worker.py, cli.py) — no need to source manually.

# --- z.ai native (coding endpoint) ---
# The 11 glm proposer roles (analyst, architect, clarify, deep_review,
# devops_planner, handoff, merge_verdict, planner, qa, research, reviewer)
# run as zai:glm-5.3 and read ZAI_API_KEY.
ZAI_API_KEY=your-zai-api-key
# Only set this to leave the coding endpoint (gateway, proxy, another env).
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# E2: on the coding endpoint a zai:glm-5.2 request is ANSWERED by glm-5.3 --
# name the model you mean; the served model follows the endpoint.

# --- Anthropic-compatible endpoint (z.ai) ---
# Serves the claude roles (adversary, discover, risk) and the coding CLIs
# that authenticate from ANTHROPIC_* (005 Q3: both variables stay as-is).
ANTHROPIC_API_KEY=your-zai-api-key
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Temporal ---
TEMPORAL_HOST=localhost:7233

# --- Research provider (Exa) ---
# The shipped research role declares `provider: exa` (agents/research/
# agent.yaml), and validate_registry fails closed at boot without the key --
# the worker does not start, whether or not a run ever uses research.
EXA_API_KEY=your-exa-api-key
# Only if you switch that role to `provider: tavily`.
# TAVILY_API_KEY=your-tavily-api-key

# --- Hindsight memory backend (docker-compose "hindsight" service) ---
# Required for the memory bank's LLM-backed retain/recall/reflect. Any
# HINDSIGHT_API_LLM_PROVIDER-compatible key (openai, anthropic, gemini, ...).
HINDSIGHT_API_LLM_API_KEY=your-llm-api-key
HINDSIGHT_API_LLM_PROVIDER=openai
# Flip these to actually use Hindsight instead of the in-process fake backend.
SDLC_MEMORY_ENABLED=true
SDLC_MEMORY_BACKEND=hindsight
SDLC_MEMORY_BASE_URL=http://hindsight:8888
# Tenant path segment; `default` for a single-tenant self-hosted container.
SDLC_MEMORY_TENANT=default
# Only needed if the Hindsight deployment enforces bearer auth. Read inside
# the activity and never placed on an activity input — those are serialized
# into Temporal workflow history.
# SDLC_MEMORY_API_KEY=

# --- GitHub (pull-request delivery) ---
# Read by `gh` (and, through the image's credential helper, by `git push`) in
# activities.open_pull_request — the last step of a feature run. Without it a
# run reaches the PR step with every gate green and then fails to push.
# Needs `repo` scope on the repository the run targets. Benchmark runs skip
# the PR step entirely (scratch checkouts have no remote), so this is only
# required for real runs against a GitHub repository.
GH_TOKEN=your-github-token

# --- Tunables (optional) ---
# Check this file against your environment with:
#   python -m sdlc.cli doctor
# It reports unset keys, values still equal to the placeholders above, a
# missing git committer identity, absent CLIs, and an unreachable Temporal.
#
# Fleet back-pressure (B4). Max FeatureWorkflow runs allowed to be awaiting a
# human decision at once; a new run refuses to start at or above this number,
# from every surface (CLI `start`, operator chat, dashboard). Counts runs, not
# questions -- one run with three open questions counts once -- and counts a
# live run whose state cannot be queried, so degraded visibility blocks
# visibly instead of over-admitting silently. Unset means no cap.
# SDLC_FLEET_PENDING_CAP=5
# SDLC_WORKTREES_ROOT=/tmp/sdlc/worktrees
# Graph store root (E-75/E-77): where graphs/<sha>.yaml, layouts, registry
# snapshots and run pointers live. MUST be absolute -- relative values are
# refused with a ValueError instead of silently anchoring at the process
# CWD. Unset: anchored to the enclosing checkout and materialized under
# the system temp dir (sdlc/graph_store/<checkout-digest>/).
# SDLC_GRAPH_STORE=D:/sdlc/graph-store
# SDLC_MODEL_MAX_TOKENS=64000
# SDLC_LONG_ACTIVITY_HEARTBEAT_MINUTES=60
# SDLC_LONG_ACTIVITY_TIMEOUT_HOURS=4
# Path to the agents/ registry directory. Set explicitly in the image; locally
# it is discovered by walking up for pyproject.toml + agents/registry.yaml.
# SDLC_AGENTS_DIR=/app/agents

# Operator chat surface (E-86). Set to 1 to mount the Pydantic AI chat agent
# at /chat on the dashboard app. Off by default: it spends tokens and lets a
# model propose gate decisions. Needs the model provider key its
# interfaces/chat/agent.yaml names.
SDLC_CHAT_ENABLED=0
# Where interfaces/chat/{agent.yaml,instructions.md} live. Only needed when
# sdlc is not running from a source checkout -- agent.py cannot locate the
# repo root from site-packages. The worker image sets this for you.
# SDLC_CHAT_ASSETS=/app/interfaces/chat
